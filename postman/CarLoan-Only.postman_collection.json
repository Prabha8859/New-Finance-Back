{
  "info": {
    "name": "Indexia — Car Loan Only",
    "_postman_id": "indexia-car-loan-002",
    "description": "Standalone collection: Auth (user + admin) and the full Car Loan flow.\n\nHOW TO RUN (in order):\n1. Set baseUrl (and adminEmail/adminPassword) in the environment.\n2. Run 'Auth — User': Register & Send OTP -> Verify OTP (saves {{userToken}}). If the mobile is already registered, run the Login fallback instead.\n3. Run 'Auth — Admin': Admin Login (saves {{adminToken}}).\n4. Run the Car Loan folder top to bottom. Every Apply saves {{carLoanId}} so 'Admin — Car Loan by ID' works instantly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth — User (run first)",
      "item": [
        {
          "name": "Register & Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"mobile\": \"{{userMobile}}\",\n  \"email\": \"{{userEmail}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Sends OTP. In dev the OTP is always 123456 (STATIC_OTP in .env). If this returns 'User already registered', run the two Login requests below instead."
          }
        },
        {
          "name": "Verify OTP (saves userToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set('userToken', data.token);",
                  "pm.test('OTP verified', () => pm.expect(data.success).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{userMobile}}\",\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-otp"]
            }
          }
        },
        {
          "name": "Login (fallback if already registered)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{userMobile}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Use when the mobile is already registered. Sends a fresh OTP (123456 in dev)."
          }
        },
        {
          "name": "Verify Login OTP (saves userToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set('userToken', data.token);",
                  "pm.test('login verified', () => pm.expect(data.success).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{userMobile}}\",\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", "verify"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth — Admin (run for admin requests)",
      "item": [
        {
          "name": "Admin Login (saves adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set('adminToken', data.token);",
                  "pm.test('admin login', () => pm.expect(data.success).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "auth", "login"]
            },
            "description": "Uses adminEmail / adminPassword from the environment."
          }
        }
      ]
    },
    {
      "name": "Car Loan",
      "item": [
        {
          "name": "Apply — Salaried (all fields)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.data && data.data._id) pm.collectionVariables.set('carLoanId', data.data._id);",
                  "pm.test('201 created', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanAmount\": 800000,\n  \"loanTenureYears\": 7,\n\n  \"vehicleType\": \"SUV\",\n  \"vehicleTypeOther\": \"\",\n  \"transmissionType\": \"Automatic\",\n  \"transmissionTypeOther\": \"\",\n  \"manufacturer\": \"Hyundai\",\n  \"model\": \"Creta\",\n  \"vehiclePurchaseType\": \"New Vehicle\",\n  \"vehiclePurchaseTypeOther\": \"\",\n\n  \"employmentType\": \"Salaried\",\n  \"companyName\": \"ABC Corp\",\n  \"companyType\": \"Private Limited\",\n  \"companyTypeOther\": \"\",\n  \"monthlyNetSalary\": 75000,\n  \"salaryReceivedAs\": \"Bank Transfer\",\n  \"salaryReceivedAsOther\": \"\",\n  \"salaryBankName\": \"HDFC Bank\",\n  \"salaryBankOther\": \"\",\n\n  \"existingEMI\": 0,\n  \"existingLoanAmount\": 0,\n  \"existingBanks\": [],\n  \"otherBankList\": [],\n  \"existingLoanTypes\": [],\n  \"otherLoanList\": [],\n\n  \"fullName\": \"{{userName}}\",\n  \"mobile\": \"{{userMobile}}\",\n  \"email\": \"{{userEmail}}\",\n  \"dob\": \"1992-06-15\",\n  \"panNumber\": \"ABCDE1234F\",\n  \"state\": \"Maharashtra\",\n  \"city\": \"Pune\",\n  \"pincode\": \"411001\",\n  \"residenceStatus\": \"Owned\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/car-loan/apply",
              "host": ["{{baseUrl}}"],
              "path": ["api", "car-loan", "apply"]
            },
            "description": "Car loan apply as Salaried. All fields present; *Other free-text fields empty. loanTenureYears is converted to months automatically."
          }
        },
        {
          "name": "Apply — Self Employed Business (Other + multi-bank)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.data && data.data._id) pm.collectionVariables.set('carLoanId', data.data._id);",
                  "pm.test('201 created', () => pm.expect(pm.response.code).to.eql(201));",
                  "pm.test('Other resolved to free text', () => pm.expect(data.data.vehicleType).to.eql('Tractor'));",
                  "pm.test('multi-bank stored', () => pm.expect(data.data.transactionBankName.banks).to.have.lengthOf(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanAmount\": 1200000,\n  \"loanTenure\": 60,\n  \"employmentType\": \"Self Employed - Business\",\n\n  \"vehicleType\": \"Other\",\n  \"vehicleTypeOther\": \"Tractor\",\n  \"vehiclePurchaseType\": \"Used Vehicle\",\n\n  \"businessType\": \"Proprietorship\",\n  \"businessTypeOther\": \"\",\n  \"businessName\": \"Aarav Traders\",\n  \"gstNumber\": \"\",\n  \"companyPanNumber\": \"ABCDE1234F\",\n  \"natureOfBusiness\": \"Retail\",\n  \"natureOfBusinessOther\": \"\",\n  \"industryType\": \"Trading\",\n  \"industryTypeOther\": \"\",\n  \"subIndustry\": \"\",\n  \"businessEstablishedDate\": \"2018-05-12\",\n  \"lastYearTurnover\": 2500000,\n  \"last2YearsTurnover\": 2300000,\n  \"lastYearNetIncome\": 350000,\n  \"last2YearsNetIncome\": 300000,\n  \"businessState\": \"Maharashtra\",\n  \"businessCity\": \"Pune\",\n  \"businessPincode\": \"411001\",\n  \"businessPincodeOther\": \"\",\n  \"businessPlaceStatus\": \"Owned\",\n  \"businessPlaceStatusOther\": \"\",\n\n  \"transactionBankName\": \"Multiple Transaction Banks\",\n  \"transactionBanks\": [\"HDFC Bank\", \"State Bank of India\", \"ICICI Bank\"],\n\n  \"fullName\": \"{{userName}}\",\n  \"mobile\": \"{{userMobile}}\",\n  \"email\": \"{{userEmail}}\",\n  \"dob\": \"1992-06-15\",\n  \"panNumber\": \"ABCDE1234F\",\n  \"state\": \"Maharashtra\",\n  \"city\": \"Pune\",\n  \"pincode\": \"411001\",\n  \"residenceStatus\": \"Owned\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/car-loan/apply",
              "host": ["{{baseUrl}}"],
              "path": ["api", "car-loan", "apply"]
            },
            "description": "Proves the Other flow (vehicleType Other -> 'Tractor' stored) and the multi-bank flow (sentinel + transactionBanks array merged into {displayName, banks})."
          }
        },
        {
          "name": "Apply — Self Employed Professional",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.data && data.data._id) pm.collectionVariables.set('carLoanId', data.data._id);",
                  "pm.test('201 created', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanAmount\": 900000,\n  \"loanTenure\": 60,\n  \"employmentType\": \"Self Employed - Professional\",\n\n  \"vehicleType\": \"Sedan\",\n  \"manufacturer\": \"Toyota\",\n  \"model\": \"Camry\",\n\n  \"profession\": \"Doctor\",\n  \"professionOther\": \"\",\n  \"currentYearTurnover\": 500000,\n  \"priorYearTurnover\": 450000,\n  \"currentYearNetIncome\": 70000,\n  \"previousYearNetIncome\": 65000,\n  \"businessState\": \"Maharashtra\",\n  \"businessCity\": \"Pune\",\n  \"businessPincode\": \"411001\",\n  \"businessPincodeOther\": \"\",\n  \"businessPlaceStatus\": \"Owned\",\n  \"businessPlaceStatusOther\": \"\",\n\n  \"transactionBankName\": \"Multiple Transaction Banks\",\n  \"transactionBanks\": [\"HDFC Bank\", \"ICICI Bank\"],\n\n  \"fullName\": \"{{userName}}\",\n  \"mobile\": \"{{userMobile}}\",\n  \"email\": \"{{userEmail}}\",\n  \"dob\": \"1992-06-15\",\n  \"panNumber\": \"ABCDE1234F\",\n  \"state\": \"Maharashtra\",\n  \"city\": \"Pune\",\n  \"pincode\": \"411001\",\n  \"residenceStatus\": \"Owned\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/car-loan/apply",
              "host": ["{{baseUrl}}"],
              "path": ["api", "car-loan", "apply"]
            }
          }
        },
        {
          "name": "My Applications (user list)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/car-loan/applications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "car-loan", "applications"]
            },
            "description": "All car loan applications of the logged-in user, newest first. No body."
          }
        },
        {
          "name": "Admin — All Car Loans",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/car-loans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "car-loans"]
            },
            "description": "Admin list of every user's car loan applications."
          }
        },
        {
          "name": "Admin — Car Loan by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/car-loans/{{carLoanId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "car-loans", "{{carLoanId}}"]
            },
            "description": "Single application by id. {{carLoanId}} is auto-saved by the Apply requests; or paste any _id."
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "userToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "carLoanId", "value": "" },
    { "key": "userName", "value": "Rahul Sharma" },
    { "key": "userMobile", "value": "9876543210" },
    { "key": "userEmail", "value": "rahul@example.com" }
  ]
}
