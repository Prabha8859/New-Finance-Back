PORT=5000

MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>

JWT_SECRET=replace-with-a-long-random-value

OTP_EXPIRE_MINUTES=5

SMS_PROVIDER=

# Dev/staging only — must never be set in production (see SECURITY-PLAN.md §1)
STATIC_OTP=

# Admin panel seed credentials (used by `npm run seed:admin`) — do not commit real values
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Explicit CORS allowlist consumed by server.js — required in production
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
